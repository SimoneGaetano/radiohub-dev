# ──────────────────────────────────────────────
# RadioHub — variabili d'ambiente per Docker Compose
# Copia questo file in `.env` (root) e adatta i valori.
# ──────────────────────────────────────────────

# ── Porte esposte sull'host ───────────────────
BACKEND_PORT=4000
FRONTEND_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=radiohub
POSTGRES_PASSWORD=radiohub
POSTGRES_DB=radiohub

# ── Backend ──────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# Segreto per la firma dei token JWT (min 16 caratteri). CAMBIALO in produzione!
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# ── Fonti radio (B1) ─────────────────────────
# Fonte primaria indicata dalla traccia: FM-World. Il token resta LATO SERVER
# (il frontend non lo vede mai). Se è vuoto il provider primario non viene
# tentato e si usa direttamente il fallback: l'app parte anche senza credenziali.
FM_WORLD_API_BASE_URL=https://connect.fm-world.com/client2
FM_WORLD_API_TOKEN=

# Fallback (e catalogo per la risoluzione per id): Radio Browser.
# Serve anche perché l'API di FM-World non espone filtri per tag/paese/bitrate
# (le pill di genere) né una ricerca per id (preferiti e cronologia).
RADIO_API_BASE_URL=https://de1.api.radio-browser.info
RADIO_API_KEY=
RADIO_API_TIMEOUT_MS=5000
RADIO_CACHE_TTL_SECONDS=600
# TTL della cache Redis della bio AI delle stazioni (bonus "Info AI"), in secondi.
RADIO_INFO_CACHE_TTL_SECONDS=86400

# ── AI (OpenAI / Gemini) ───────────────────────
# Provider dei riassunti AI dei post (A2): auto | gemini | openai | mock.
# Con le chiavi vuote e SUMMARY_PROVIDER=auto il backend usa il provider mock
# e l'app funziona comunque (nessuna chiamata esterna).
SUMMARY_PROVIDER=auto
# Modello del provider (vuoto = default: gemini-2.5-flash / gpt-4o-mini).
SUMMARY_MODEL=
# Limite di caratteri dell'articolo inviato al modello (troncamento, A3).
SUMMARY_MAX_INPUT_CHARS=6000
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Feed notizie (ingestion periodica, B2/B3) ─
# Fonte esterna letta dal backend e salvata nella tabella "Post".
NEWS_FEED_URL=https://d3r6kmd22dkoyn.cloudfront.net/
# Intervallo del job periodico in secondi (default 300 = 5 minuti).
NEWS_SYNC_INTERVAL_SECONDS=300
# Chiave richiesta da POST /api/sync (header X-Sync-Key). Se vuota la rotta
# risponde 503: impostala per abilitare la sincronizzazione manuale.
SYNC_API_KEY=