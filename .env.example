# ──────────────────────────────────────────────
# RadioHub — variabili d'ambiente per Docker Compose
# Copia questo file in `.env` (root) e adatta i valori.
# ──────────────────────────────────────────────

# ── Porte esposte sull'host ───────────────────
BACKEND_PORT=4000
FRONTEND_PORT=8080
POSTGRES_PORT=5433
REDIS_PORT=6379

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=radiohub
POSTGRES_PASSWORD=radiohub
POSTGRES_DB=radiohub

# ── Backend ──────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# Segreto per la firma dei token JWT (min 16 caratteri). CAMBIALO in produzione!
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# ── Radio source (upstream API) ──────────────
RADIO_API_BASE_URL=https://de1.api.radio-browser.info
RADIO_API_KEY=
RADIO_API_TIMEOUT_MS=5000
RADIO_CACHE_TTL_SECONDS=600