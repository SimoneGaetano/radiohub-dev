# ──────────────────────────────────────────────
# RadioHub — Backend environment configuration
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://radiohub:radiohub@localhost:5433/radiohub?schema=public
POSTGRES_USER=radiohub
POSTGRES_PASSWORD=radiohub
POSTGRES_DB=radiohub
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Radio source (upstream API) ───────────────
# Endpoint pubblico Radio Browser (nessuna chiave richiesta di default)
RADIO_API_BASE_URL=https://de1.api.radio-browser.info
# Chiave opzionale: se impostata viene inviata come header X-API-Key
RADIO_API_KEY=
# Timeout delle richieste esterne (ms)
RADIO_API_TIMEOUT_MS=5000
# TTL della cache Redis per la ricerca radio (secondi)
RADIO_CACHE_TTL_SECONDS=600

# ── Auth (JWT) ────────────────────────────────
# Segreto per la firma dei token JWT (min 16 caratteri). CAMBIALO in produzione!
JWT_SECRET=change-me-with-a-long-random-secret
# Durata del token (es. 1h, 7d)
JWT_EXPIRES_IN=1h
