# ──────────────────────────────────────────────
# RadioHub — Backend environment configuration
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# ── Application ───────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://radiohub:radiohub@localhost:5433/radiohub?schema=public
POSTGRES_USER=radiohub
POSTGRES_PASSWORD=radiohub
POSTGRES_DB=radiohub
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Radio source (upstream API) ───────────────
# Endpoint pubblico Radio Browser (nessuna chiave richiesta di default)
RADIO_API_BASE_URL=https://de1.api.radio-browser.info
# Chiave opzionale: se impostata viene inviata come header X-API-Key
RADIO_API_KEY=
# Timeout delle richieste esterne (ms)
RADIO_API_TIMEOUT_MS=5000
# TTL della cache Redis per la ricerca radio (secondi)
RADIO_CACHE_TTL_SECONDS=600
# TTL della cache Redis della bio AI delle stazioni (bonus "Info AI"): evita di
# richiamare il modello a ogni apertura del pannello. Default 24 ore (86400 s).
RADIO_INFO_CACHE_TTL_SECONDS=86400

# ── AI (OpenAI / Gemini) ───────────────────────────────
# Se configurata, il backend invoca l'API reale al posto del fallback dinamico.
# Sono supportate due chiavi: GEMINI_API_KEY o OPENAI_API_KEY.
# Se entrambe sono presenti, vince GEMINI_API_KEY (gemini-1.5-flash).
OPENAI_API_KEY=
GEMINI_API_KEY=
# Provider dei riassunti dei post (A2): auto | gemini | openai | mock.
# `auto` = Gemini se la chiave è presente, altrimenti OpenAI, altrimenti mock.
SUMMARY_PROVIDER=auto
# Modello usato dal provider (vuoto = default del provider: gemini-2.5-flash /
# gpt-4o-mini). Utile se il nome del modello cambia nel tempo.
SUMMARY_MODEL=
# Caratteri massimi di articolo inviati al modello: oltre questa soglia il testo
# viene troncato (A3). Non impatta il contenuto salvato in database.
SUMMARY_MAX_INPUT_CHARS=6000

# ── News feed (ingestion periodica per /api/posts) ─────
# Fonte esterna delle notizie, letta periodicamente e salvata nella tabella "Post".
NEWS_FEED_URL=https://d3r6kmd22dkoyn.cloudfront.net/
# Intervallo di sincronizzazione periodica (secondi). Default 300 s (5 minuti),
# allineato all'esempio della traccia; aumentalo se vuoi ridurre le chiamate esterne.
NEWS_SYNC_INTERVAL_SECONDS=300
# ── Rate limiting (X6) ─────────────────────────────────
# Contatori su Redis, un bucket per tipo di quota. Valori di default pensati per
# lo sviluppo: la quota generale è alta (300/min) per non intralciare l'uso
# normale, quella sulle credenziali è stretta (10/15 min) perché è la difesa da
# forza bruta, e quella sui riassunti AI protegge il costo del modello.
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_SECONDS=300

# ── Proxy e deploy (X2) ────────────────────────────────
# Quanti proxy fidati stanno davanti al backend: 1 in locale (nginx del
# frontend), 2 su una piattaforma cloud che aggiunge un proprio edge.
# Sbagliarlo significa far contare al rate limiting l'IP del proxy e non quello
# del client. `false` disattiva la fiducia negli header (nessun proxy davanti).
TRUST_PROXY=1

# Porta di ascolto del backend: in locale 4000. Alcune piattaforme cloud la
# assegnano loro (variabile PORT) e il valore va lasciato com'è.
# PORT=4000

