// RadioHub — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  favorites Favorite[]
  recents   RecentPlay[]
  summaries PostSummary[]
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  radioId   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, radioId])
}

/// Recently played stations of a signed-in user (the device keeps its own list
/// in localStorage: the server copy is what makes the history follow the user).
model RecentPlay {
  id       String   @id @default(uuid())
  userId   String
  radioId  String
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, radioId])
  @@index([userId, playedAt])
}

/// AI summary of a post **per user**: user A summarising article 1 does not
/// consume or expose the summary of article 2 generated by user B.
/// `Post.summary` stays as the shared cache used by guests.
model PostSummary {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  summary   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Post {
  id          String   @id @default(uuid())
  externalId  String   @unique
  title       String
  content     String
  publishedAt DateTime
  summary     String?
  createdAt   DateTime @default(now())

  summaries PostSummary[]
}
