# RadioHub — configurazione nginx del frontend (X2).
#
# È un **template**, non un file di configurazione: l'immagine `nginx:alpine`
# esegue `envsubst` all'avvio sui file in `/etc/nginx/templates/*.template` e
# scrive il risultato in `/etc/nginx/conf.d/`. Serve a non avere l'indirizzo del
# backend **dentro** l'immagine: in locale è `backend:4000` (il nome del servizio
# in Docker), su un cloud è l'hostname interno del servizio backend. Senza questo,
# la stessa immagine funzionerebbe solo in un posto.
#
# La sostituzione riguarda **solo** le variabili d'ambiente definite
# (`BACKEND_SCHEME`, `BACKEND_HOST`, `BACKEND_PORT`): `$host`, `$uri`,
# `$remote_addr` restano quelli di nginx, perché `envsubst` viene invocato con
# l'elenco delle variabili esistenti.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # X5 — flusso SSE dei post: nginx NON deve bufferizzare, altrimenti gli
    # eventi restano nel buffer del proxy e il browser li vede solo alla chiusura
    # della connessione. Il timeout di lettura lungo evita che una connessione
    # silenziosa venga chiusa fra un heartbeat e l'altro (il backend ne manda uno
    # ogni 25 s). `Connection ''` mantiene la connessione upstream riutilizzabile
    # invece di degradarla a `close`.
    location /api/posts/stream {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        # Upstream HTTPS (X2): SNI obbligatorio verso un servizio pubblico, che
        # presenta più certificati sullo stesso indirizzo. Innocuo su http.
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # API -> backend container (keeps the browser on a single origin, no CORS)
    location /api/ {
        proxy_pass ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # App shell: `no-cache` forces revalidation, so pressing refresh always
    # fetches the latest index.html (and therefore the latest asset hashes).
    # Without it a browser/proxy may keep serving a stale shell, whose asset
    # URLs no longer exist after a redeploy (-> blank page on refresh).
    # NOTE: the SPA fallback below internally redirects to /index.html, which is
    # matched again by this exact location, so the header also applies there.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The service worker itself must never be cached, or clients would never
    # see an updated sw.js (and thus never drop the old cached shell).
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    # Hashed filenames are content-addressed: safe to cache forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
